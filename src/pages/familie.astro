---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const faqs = [
  {
    q: "Wann erhalten wir die Bilder?",
    a: "Innerhalb von maximal 14 Tagen erhaltet ihr die bearbeiteten Bilder über einen Link zu einer Online-Galerie von uns. Dort könnt ihr die Bilder herunterladen und teilen.",
  },
  {
    q: "Wie werden uns die Bilder zur Verfügung gestellt?",
    a: "Die Bilder werden euch in einer Online-Galerie zur Verfügung gestellt, die ihr ganz nach Belieben mit Freunden und Familie teilen könnt. Auf Wunsch richten wir die Galerie auch passwortgeschützt ein. Ihr habt die Möglichkeit, die Bilder in voller Auflösung und ohne Wasserzeichen herunterzuladen. Die Galerie bleibt für mindestens 3 Monate online, oftmals aber auch länger.",
  },
  {
    q: "Wie lange ist die Online-Galerie verfügbar?",
    a: "Mindestens 3 Monate, meistens länger. Ladet euch die Bilder trotzdem gleich in den ersten Wochen runter und sichert sie gut – die Galerie ist kein Dauerspeicher.",
  },
  {
    q: "Bekommen wir auch die RAW-Dateien?",
    a: "Ihr bekommt alle Bilder fertig bearbeitet in hoher Auflösung. Unbearbeitete Dateien oder RAWs geben wir nicht raus; die fertige Bearbeitung gehört für uns zum Bild dazu.",
  },
  {
    q: "Wie und wann bezahlen wir?",
    a: "Bei uns habt ihr die Wahl: Ihr könnt bequem per PayPal, Überweisung oder bei kleineren Beträgen auch in bar zahlen. Unsere Zahlungsbedingungen werden vertraglich festgelegt, um Transparenz und Sicherheit für beide Seiten zu gewährleisten.",
  },
  {
    q: "Was passiert, wenn ihr ausfallt?",
    a: "Dass wir beide krank sind ist sehr unwahrscheinlich. Falls es wirklich so sein sollte, können wir den Termin natürlich verschieben. Das gilt auch, wenn ihr erkranken solltet.",
  },
  {
    q: "Was kostet ein Familienshooting?",
    a: "Unsere Preise beginnen bei 150 € und reichen bis zu 300 €. Das richtet sich nach der Länge des Shootings und der Anzahl der Bilder, die ihr gerne haben möchtet.",
  },
];
---

<BaseLayout
  title="Familienfotografie – MiNi Photography"
  description="Authentische Familienfotografie von Miette & Nicolai. Wir halten eure gemeinsamen Momente natürlich und ungestellt fest."
>
  <Nav />
  <main id="main">

    <!-- ─── Hero ─────────────────────────────────────────── -->
    <section class="fa-hero" aria-label="Familienfotografie">
      <div class="fa-hero__img">
        <img
          src="/images/website/hero/familie-angebot.jpg"
          alt="Familienfotografie – MiNi Photography"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="fa-hero__overlay"></div>
      <div class="fa-hero__content">
        <a href="/" class="fa-hero__back">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="13" y1="8" x2="3" y2="8"/><polyline points="7,4 3,8 7,12"/>
          </svg>
          Startseite
        </a>
        <div class="fa-hero__text">
          <h1 class="fa-hero__title">Familien</h1>
          <span class="fa-hero__sub">Euer Familienglück, festgehalten.</span>
        </div>
      </div>
      <div class="fa-hero__scroll" aria-hidden="true">
        <div class="fa-hero__scroll-line"></div>
        <span>Scroll</span>
      </div>
    </section>

    <!-- ─── Intro ─────────────────────────────────────────── -->
    <section class="fa-intro">
      <div class="fa-intro__inner">
        <blockquote class="fa-intro__quote">
          Der Ort, an dem das Herz zu Hause ist&nbsp;und<br/>
          <em>die Liebe niemals endet.</em>
        </blockquote>
      </div>
    </section>

    <!-- ─── Leistungen ─────────────────────────────────────── -->
    <section class="fa-services">
      <div class="fa-services__inner">
        <div class="fa-services__header">
          <span class="fa-services__label">Unsere Leistungen</span>
          <h2 class="fa-services__heading">Was wir für euch <em>festhalten</em></h2>
          <div class="fa-services__divider"></div>
        </div>
        <div class="fa-services__grid">
          <div class="fa-services__card">
            <div class="fa-services__card-inner">
              <img src="/images/website/services/babybauch.jpg" alt="Babybauch Shooting" class="fa-services__img" />
              <div class="fa-services__num">01</div>
              <div class="fa-services__content">
                <div class="fa-services__title">Babybauch</div>
                <div class="fa-services__subtitle">Schwangerschaft · Vorfreude</div>
                <div class="fa-services__desc">Ein runder Bauch, ganz viel Vorfreude – wir halten diesen besonderen Moment für euch fest.</div>
              </div>
            </div>
          </div>
          <div class="fa-services__card">
            <div class="fa-services__card-inner">
              <img src="/images/website/services/newborn.jpg" alt="Newborn Shooting" class="fa-services__img" style="object-position: center center;" />
              <div class="fa-services__num">02</div>
              <div class="fa-services__content">
                <div class="fa-services__title">Newborn</div>
                <div class="fa-services__subtitle">Neugeborene · Erste Momente</div>
                <div class="fa-services__desc">Behutsam & liebevoll – die ersten Tage mit eurem Baby, für immer festgehalten.</div>
              </div>
            </div>
          </div>
          <div class="fa-services__card">
            <div class="fa-services__card-inner">
              <img src="/images/website/services/familienshooting.jpg" alt="Familien Shooting" class="fa-services__img fa-services__img--top" />
              <div class="fa-services__num">03</div>
              <div class="fa-services__content">
                <div class="fa-services__title">Familie</div>
                <div class="fa-services__subtitle">Familien · Geschwister · Haustiere</div>
                <div class="fa-services__desc">Kein Posieren – einfach ihr, wie ihr seid. Lebendig & authentisch.</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Portfolio Teaser ──────────────────────────────── -->
    <section class="fa-portfolio">
      <div class="fa-portfolio__inner">
        <div class="fa-portfolio__text">
          <span class="fa-portfolio__label">Unsere Arbeit</span>
          <h2 class="fa-portfolio__heading">Familie, <em>festgehalten.</em></h2>
          <p class="fa-portfolio__body">Schaut euch unsere Familiengalerie an und lasst euch inspirieren. Jede Familie hat ihre eigene Geschichte – und genau die halten wir fest.</p>
          <a href="/familie/portfolio" class="fa-portfolio__btn">
            Portfolio ansehen
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/>
            </svg>
          </a>
        </div>
        <div class="fa-portfolio__visual">
          <div class="fa-portfolio__img-wrap">
            <img src="/images/website/hero/familie-angebot.jpg" alt="Familienportfolio MiNi Photography" width="800" height="1000" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Tipps ───────────────────────────────────────────── -->
    <section class="fa-tips">
      <div class="fa-tips__inner">
        <div class="fa-tips__header">
          <span class="fa-tips__label">Vorbereitung</span>
          <h2 class="fa-tips__heading">Unsere <em>Tipps</em> für euch</h2>
          <div class="fa-tips__divider"></div>
        </div>
        <div class="fa-tips__grid">
          <div class="fa-tips__card">
            <span class="fa-tips__icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.57a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.57a2 2 0 0 0-1.34-2.23z"/>
              </svg>
            </span>
            <div class="fa-tips__title">Outfit &amp; Farben</div>
            <p class="fa-tips__text">Wählt aufeinander abgestimmte, gedeckte Farbtöne – Beige, Weiß, Erdtöne oder sanfte Blautöne wirken besonders harmonisch. Vermeidet große auffällige Muster oder Logo-Prints, die vom Wesentlichen ablenken.</p>
            <div class="fa-tips__highlight">→ Tipp: Mehrere Layers (z.B. Jacke/Cardigan) geben euch mehr Abwechslung</div>
          </div>
          <div class="fa-tips__card">
            <span class="fa-tips__icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4"/>
                <line x1="12" y1="2" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22"/>
                <line x1="4.93" y1="4.93" x2="6.34" y2="6.34"/><line x1="17.66" y1="17.66" x2="19.07" y2="19.07"/>
                <line x1="2" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="22" y2="12"/>
                <line x1="4.93" y1="19.07" x2="6.34" y2="17.66"/><line x1="17.66" y1="6.34" x2="19.07" y2="4.93"/>
              </svg>
            </span>
            <div class="fa-tips__title">Das Licht macht den Unterschied</div>
            <p class="fa-tips__text">Die schönsten Bilder entstehen in der „Goldenen Stunde" – ca. 1 Stunde vor Sonnenuntergang. Das warme, weiche Licht schmeichelt und schafft eine magische Atmosphäre. Wir helfen euch gerne bei der Zeitplanung!</p>
            <div class="fa-tips__highlight">→ Für Newborn: Natürliches Tageslicht am Vormittag ist ideal</div>
          </div>
          <div class="fa-tips__card">
            <span class="fa-tips__icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/>
              </svg>
            </span>
            <div class="fa-tips__title">Die richtige Location</div>
            <p class="fa-tips__text">Orte mit persönlicher Bedeutung machen Bilder besonders. Parks, Wälder, Felder oder eure eigene Wohnung – alles ist möglich. In Frankfurt und Umgebung gibt es viele wunderschöne Spots. Wir kennen einige Geheimtipps!</p>
            <div class="fa-tips__highlight">→ Gerne beraten wir euch persönlich zu Locations</div>
          </div>
          <div class="fa-tips__card">
            <span class="fa-tips__icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><path d="M8 13s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>
              </svg>
            </span>
            <div class="fa-tips__title">Entspannt bleiben</div>
            <p class="fa-tips__text">Das Wichtigste: Entspannt euch und habt Spaß! Kinder dürfen Kinder sein, Babys dürfen quengeln – wir nehmen uns die Zeit die wir brauchen. Die echten Momente entstehen wenn niemand ans Fotografiert-werden denkt.</p>
            <div class="fa-tips__highlight">→ Bringt eure Lieblingssnacks mit – gute Stimmung garantiert!</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── FAQ ──────────────────────────────────────────── -->
    <section class="fa-faq">
      <div class="fa-faq__inner">
        <div class="fa-faq__header">
          <span class="section-label">FAQ</span>
          <h2 class="fa-faq__heading">Eure Fragen.<br/><em>Unsere Antworten.</em></h2>
        </div>
        <div class="fa-faq__list">
          {faqs.map((item, i) => (
            <details class="fa-faq__item" name="familie-faq">
              <summary class="fa-faq__question">
                <span class="fa-faq__q-num">0{i + 1}</span>
                <span>{item.q}</span>
                <svg class="fa-faq__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="4,6 8,10 12,6"/>
                </svg>
              </summary>
              <div class="fa-faq__answer">
                <p>{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── Blog ─────────────────────────────────────────── -->
    <section class="fa-blog">
      <div class="fa-blog__inner">
        <span class="fa-blog__eyebrow">Aus unserem Blog</span>
        <div class="fa-blog__links">
          <a href="/blog/familie-mitwachsen" class="fa-blog__link">
            Bilder, die mitwachsen
            <svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ─── CTA ──────────────────────────────────────────── -->
    <section class="fa-cta">
      <div class="fa-cta__inner">
        <span class="fa-cta__eyebrow">Schreibt uns!</span>
        <div class="fa-cta__image">
          <img src="/images/website/cta/uns-bei-der-arbeit.jpg" alt="Miette und Nicolai bei der Arbeit" loading="lazy" />
        </div>
        <h2 class="fa-cta__heading">Gemeinsam verewigen wir<br/><em>eure schönsten Momente.</em></h2>
        <a href="/#kontakt" class="fa-cta__btn">
          Kontakt
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/>
          </svg>
        </a>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
/* ─── Hero ────────────────────────────────────────────────── */
.fa-hero {
  position: relative;
  height: 100dvh;
  min-height: 600px;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}

.fa-hero__img {
  position: absolute;
  inset: 0;
}

.fa-hero__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  animation: faBreathe 10s ease-in-out infinite;
}

@keyframes faBreathe {
  0%, 100% { transform: scale(1); }
  50%       { transform: scale(1.035); }
}

.fa-hero__overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to top, rgba(30,20,16,0.85) 0%, rgba(30,20,16,0.25) 50%, rgba(30,20,16,0.1) 100%),
    linear-gradient(to right, rgba(30,20,16,0.3) 0%, transparent 60%);
}

.fa-hero__content {
  position: relative;
  z-index: 2;
  padding: var(--space-16) var(--container-gutter);
  width: 100%;
  max-width: var(--container-max);
  margin-inline: auto;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
}

.fa-hero__back {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-family: var(--font-body);
  font-size: 0.7rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: rgba(255,252,250,0.6);
  transition: color 0.3s ease;
  margin-top: 120px;
}

.fa-hero__back:hover { color: rgba(255,252,250,0.9); }

.fa-hero__text {
  padding-bottom: var(--space-8);
}

.fa-hero__title {
  font-family: var(--font-display);
  font-size: clamp(4rem, 10vw, 10rem);
  font-weight: 700;
  color: #fffcfa;
  line-height: 0.9;
  letter-spacing: -0.02em;
  opacity: 0;
  animation: faFadeUp 1s ease forwards 0.4s;
}

.fa-hero__sub {
  display: block;
  font-family: var(--font-display);
  font-size: clamp(1.1rem, 2vw, 1.6rem);
  font-weight: 300;
  font-style: italic;
  color: rgba(255,252,250,0.7);
  margin-top: var(--space-4);
  opacity: 0;
  animation: faFadeUp 0.9s ease forwards 0.65s;
}

.fa-hero__scroll {
  position: absolute;
  bottom: var(--space-8);
  right: var(--container-gutter);
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  font-family: var(--font-body);
  font-size: 0.6rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: rgba(196,181,172,0.6);
  writing-mode: vertical-lr;
  transform: rotate(180deg);
  opacity: 0;
  animation: faFadeUp 1s ease forwards 1s;
}

.fa-hero__scroll-line {
  width: 1px;
  height: 48px;
  background: linear-gradient(to bottom, transparent, rgba(196,181,172,0.5));
  margin-bottom: var(--space-2);
}

@keyframes faFadeUp {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ─── Intro ────────────────────────────────────────────────── */
.fa-intro {
  background: var(--color-cream);
  padding: clamp(4rem, 8vw, 8rem) var(--container-gutter);
  max-width: var(--container-max);
  margin-inline: auto;
}

.fa-intro__inner {
  max-width: 900px;
  margin-inline: auto;
  text-align: center;
}

.fa-intro__quote {
  font-family: var(--font-display);
  font-size: clamp(1.6rem, 3vw, 2.5rem);
  font-weight: 500;
  line-height: 1.25;
  color: var(--color-bark);
  margin: 0;
  border: none;
  text-align: center;
}

.fa-intro__quote em {
  font-style: italic;
  font-weight: 300;
  color: var(--color-clay);
}

/* ─── Services ─────────────────────────────────────────────── */
.fa-services {
  background: var(--color-parchment);
  padding: clamp(4rem, 8vw, 8rem) var(--container-gutter);
}

.fa-services__inner {
  max-width: var(--container-max);
  margin-inline: auto;
}

.fa-services__header {
  text-align: center;
  margin-bottom: clamp(3rem, 5vw, 5rem);
}

.fa-services__label {
  display: block;
  font-family: var(--font-body);
  font-size: 0.7rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--color-clay);
  margin-bottom: var(--space-4);
}

.fa-services__heading {
  font-family: var(--font-display);
  font-size: clamp(2rem, 3.5vw, 2.8rem);
  font-weight: 500;
  color: var(--color-bark);
  line-height: 1.2;
  margin: 0 0 var(--space-6);
}

.fa-services__heading em {
  font-style: italic;
  font-weight: 300;
  color: var(--color-clay);
}

.fa-services__divider {
  width: 60px;
  height: 1px;
  background: var(--color-clay);
  margin: 0 auto;
}

.fa-services__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2px;
}

.fa-services__card {
  position: relative;
  overflow: hidden;
}

.fa-services__card-inner {
  aspect-ratio: 4 / 5;
  position: relative;
  overflow: hidden;
  transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.fa-services__card:hover .fa-services__card-inner {
  transform: scale(1.02);
}

.fa-services__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.fa-services__img--top {
  object-position: center top;
}

.fa-services__num {
  position: absolute;
  top: 2rem;
  left: 2rem;
  font-family: var(--font-display);
  font-size: 3.5rem;
  color: var(--color-clay);
  opacity: 1;
  line-height: 1;
}

.fa-services__content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 2.5rem 2rem;
  background: linear-gradient(to top, rgba(30,22,20,0.97) 0%, rgba(30,22,20,0.6) 50%, rgba(30,22,20,0.15) 100%);
  color: white;
}

.fa-services__title {
  font-family: var(--font-display);
  font-size: 1.7rem;
  font-style: italic;
  margin-bottom: 0.5rem;
  text-shadow: 0 2px 8px rgba(0,0,0,0.4);
}

.fa-services__subtitle {
  font-family: var(--font-body);
  font-size: 0.72rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #d4975a;
  margin-bottom: 1rem;
}

.fa-services__desc {
  font-family: var(--font-body);
  font-size: 0.88rem;
  line-height: 1.7;
  color: rgba(255,255,255,0.8);
  font-weight: 300;
  opacity: 0;
  max-height: 0;
  overflow: hidden;
  transition: opacity 0.4s ease, max-height 0.4s ease;
}

.fa-services__card:hover .fa-services__desc {
  opacity: 1;
  max-height: 200px;
}

@media (max-width: 720px) {
  .fa-services__grid {
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  .fa-services__desc {
    opacity: 1;
    max-height: 200px;
  }
}

/* ─── Reasons ──────────────────────────────────────────────── */
/* ─── Portfolio ────────────────────────────────────────────── */
.fa-portfolio {
  background: var(--color-cream);
  overflow: hidden;
}

.fa-portfolio__inner {
  max-width: var(--container-max);
  margin-inline: auto;
  padding: 0 var(--container-gutter);
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  min-height: 70vh;
  gap: var(--space-16);
}

.fa-portfolio__text {
  padding: clamp(3rem, 6vw, 6rem) 0;
}


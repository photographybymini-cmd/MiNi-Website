---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<section class="cmt" data-slug={slug}>
  <div class="cmt__inner">

    <div class="cmt__header">
      <span class="cmt__eyebrow">Austausch</span>
      <h2 class="cmt__title">Kommentare</h2>
    </div>

    <div class="cmt__list" id={`cmt-list-${slug}`}>
      <p class="cmt__empty">Wird geladen …</p>
    </div>

    <div class="cmt__sep"></div>

    <div class="cmt__new">
      <h3 class="cmt__new-title">Kommentar schreiben</h3>
      <form class="cmt__form" id={`cmt-form-${slug}`} novalidate>
        <div class="cmt__field">
          <label class="cmt__label" for={`cmt-name-${slug}`}>Name</label>
          <input class="cmt__input" type="text" id={`cmt-name-${slug}`} name="author_name" required autocomplete="name" />
        </div>
        <div class="cmt__field">
          <label class="cmt__label" for={`cmt-content-${slug}`}>Kommentar</label>
          <textarea class="cmt__textarea" id={`cmt-content-${slug}`} name="content" required rows="5"></textarea>
        </div>
        <div class="cmt__form-footer">
          <button type="submit" class="cmt__btn">
            Senden
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/>
            </svg>
          </button>
        </div>
        <p class="cmt__msg cmt__msg--ok" hidden>Danke! Dein Kommentar ist jetzt sichtbar.</p>
        <p class="cmt__msg cmt__msg--err" hidden>Etwas ist schiefgelaufen. Bitte versuche es erneut.</p>
      </form>
    </div>

  </div>
</section>

<script>
  import { createClient } from '@supabase/supabase-js';

  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
  const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string | undefined;

  function esc(str: string) {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function fmtDate(iso: string) {
    return new Date(iso).toLocaleDateString('de-DE', {
      day: 'numeric', month: 'long', year: 'numeric',
    });
  }

  function renderList(listEl: HTMLElement, comments: any[]) {
    if (!comments.length) {
      listEl.innerHTML = '<p class="cmt__empty">Noch keine Kommentare – sei der/die Erste!</p>';
      return;
    }
    listEl.innerHTML = comments.map((c, i) => `
      <article class="cmt__item${i < comments.length - 1 ? ' cmt__item--sep' : ''}">
        <header class="cmt__item-head">
          <span class="cmt__author">${esc(c.author_name)}</span>
          <time class="cmt__date">${fmtDate(c.created_at)}</time>
        </header>
        <p class="cmt__content">${esc(c.content)}</p>
      </article>
    `).join('');
  }

  document.querySelectorAll<HTMLElement>('.cmt[data-slug]').forEach(async (section) => {
    const slug = section.getAttribute('data-slug')!;
    const listEl = section.querySelector<HTMLElement>(`#cmt-list-${slug}`)!;
    const form = section.querySelector<HTMLFormElement>(`#cmt-form-${slug}`)!;
    const msgOk = form.querySelector<HTMLElement>('.cmt__msg--ok')!;
    const msgErr = form.querySelector<HTMLElement>('.cmt__msg--err')!;
    const btn = form.querySelector<HTMLButtonElement>('.cmt__btn')!;

    if (!SUPABASE_URL || !SUPABASE_KEY) {
      listEl.innerHTML = '<p class="cmt__empty">Noch keine Kommentare – sei der/die Erste!</p>';
      form.addEventListener('submit', (e) => e.preventDefault());
      return;
    }

    let supabase: ReturnType<typeof createClient>;
    try {
      supabase = createClient(SUPABASE_URL, SUPABASE_KEY);
    } catch {
      listEl.innerHTML = '<p class="cmt__empty">Noch keine Kommentare – sei der/die Erste!</p>';
      form.addEventListener('submit', (e) => e.preventDefault());
      return;
    }

    async function load() {
      try {
        const { data } = await supabase
          .from('comments')
          .select('author_name, content, created_at')
          .eq('post_slug', slug)
          .eq('approved', true)
          .order('created_at', { ascending: true });
        renderList(listEl, data ?? []);
      } catch {
        listEl.innerHTML = '<p class="cmt__empty">Noch keine Kommentare – sei der/die Erste!</p>';
      }
    }

    await load();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const author_name = (fd.get('author_name') as string).trim();
      const content = (fd.get('content') as string).trim();
      if (!author_name || !content) return;

      btn.disabled = true;
      btn.textContent = '…';
      msgOk.hidden = true;
      msgErr.hidden = true;

      try {
        const { error } = await supabase.from('comments').insert({ post_slug: slug, author_name, content });
        if (error) throw error;
        form.reset();
        msgOk.hidden = false;
        await load();
      } catch {
        msgErr.hidden = false;
      } finally {
        btn.disabled = false;
        btn.innerHTML = 'Senden <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/></svg>';
      }
    });
  });
</script>

<style>
.cmt {
  background: var(--color-cream);
  padding: clamp(4rem, 8vw, 6rem) var(--container-gutter);
  border-top: 1px solid rgba(74, 57, 48, 0.1);
}

.cmt__inner {
  max-width: 720px;
  margin-inline: auto;
  display: flex;
  flex-direction: column;
  gap: clamp(2.5rem, 5vw, 4rem);
}

.cmt__eyebrow {
  display: block;
  font-family: var(--font-body);
  font-size: 0.62rem;
  letter-spacing: 0.38em;
  text-transform: uppercase;
  color: var(--color-clay);
  opacity: 0.7;
  margin-bottom: 0.75rem;
}

.cmt__title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 5vw, 3rem);
  font-weight: 700;
  color: var(--color-bark);
  line-height: 1;
  letter-spacing: -0.02em;
  margin: 0;
}

.cmt__empty {
  font-family: var(--font-body);
  font-size: 0.9rem;
  font-weight: 300;
  color: var(--color-clay);
  opacity: 0.6;
}

.cmt__item {
  padding: 1.5rem 0;
}

.cmt__item--sep {
  border-bottom: 1px solid rgba(74, 57, 48, 0.08);
}

.cmt__item-head {
  display: flex;
  align-items: baseline;
  gap: 1rem;
  margin-bottom: 0.6rem;
  flex-wrap: wrap;
}

.cmt__author {
  font-family: var(--font-body);
  font-size: 0.7rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-bark);
  font-weight: 400;
}

.cmt__date {
  font-family: var(--font-body);
  font-size: 0.75rem;
  font-weight: 300;
  color: var(--color-clay);
  opacity: 0.55;
}

.cmt__content {
  font-family: var(--font-body);
  font-size: 0.95rem;
  font-weight: 300;
  color: var(--color-muted);
  line-height: 1.8;
  margin: 0;
  white-space: pre-wrap;
}

.cmt__sep {
  height: 1px;
  background: rgba(74, 57, 48, 0.1);
}

.cmt__new-title {
  font-family: var(--font-display);
  font-size: clamp(1.4rem, 3vw, 2rem);
  font-weight: 700;
  color: var(--color-bark);
  letter-spacing: -0.02em;
  margin: 0 0 2rem;
}

.cmt__form {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.cmt__field {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.cmt__label {
  font-family: var(--font-body);
  font-size: 0.65rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--color-clay);
}

.cmt__input,
.cmt__textarea {
  font-family: var(--font-body);
  font-size: 0.95rem;
  font-weight: 300;
  color: var(--color-bark);
  background: transparent;
  border: none;
  border-bottom: 1px solid rgba(74, 57, 48, 0.25);
  padding: 0.5rem 0;
  outline: none;
  width: 100%;
  transition: border-color 0.2s ease;
  resize: vertical;
}

.cmt__input:focus,
.cmt__textarea:focus {
  border-bottom-color: var(--color-bark);
}

.cmt__textarea {
  min-height: 120px;
}

.cmt__form-footer {
  display: flex;
  align-items: center;
}

.cmt__btn {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  font-family: var(--font-body);
  font-size: 0.65rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--color-cream);
  background: var(--color-bark);
  border: none;
  padding: 1rem 2.25rem;
  cursor: pointer;
  transition: background 0.25s ease, gap 0.2s ease;
}

.cmt__btn:hover:not(:disabled) {
  background: var(--color-clay);
  gap: 1.1rem;
}

.cmt__btn:disabled {
  opacity: 0.5;
  cursor: default;
}

.cmt__msg {
  font-family: var(--font-body);
  font-size: 0.85rem;
  font-weight: 300;
  margin: 0;
}

.cmt__msg--ok { color: #4a7c59; }
.cmt__msg--err { color: #c0392b; }
</style>

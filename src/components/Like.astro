---
interface Props { slug: string; }
const { slug } = Astro.props;
---

<div class="like" data-slug={slug}>
  <p class="like__label">Hat dir dieser Beitrag gefallen?</p>
  <button class="like__btn" type="button" aria-label="Gefällt mir">
    <svg class="like__heart" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
    </svg>
    <span class="like__count"></span>
  </button>
</div>

<script>
  import { createClient } from '@supabase/supabase-js';

  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
  const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string | undefined;

  document.querySelectorAll<HTMLElement>('.like[data-slug]').forEach(async (el) => {
    const slug = el.getAttribute('data-slug')!;
    const btn = el.querySelector<HTMLButtonElement>('.like__btn')!;
    const countEl = el.querySelector<HTMLElement>('.like__count')!;
    const storageKey = `liked_${slug}`;

    if (!SUPABASE_URL || !SUPABASE_KEY) return;

    let supabase: ReturnType<typeof createClient>;
    try {
      supabase = createClient(SUPABASE_URL, SUPABASE_KEY);
    } catch {
      return;
    }

    if (localStorage.getItem(storageKey) === '1') {
      btn.classList.add('like__btn--active');
      btn.disabled = true;
    }

    try {
      const { count } = await supabase
        .from('likes')
        .select('*', { count: 'exact', head: true })
        .eq('post_slug', slug);
      countEl.textContent = String(count ?? 0);
    } catch {
      countEl.textContent = '0';
    }

    btn.addEventListener('click', async () => {
      if (localStorage.getItem(storageKey) === '1') return;
      btn.disabled = true;
      try {
        const { error } = await supabase.from('likes').insert({ post_slug: slug });
        if (error) throw error;
        localStorage.setItem(storageKey, '1');
        btn.classList.add('like__btn--active');
        countEl.textContent = String((parseInt(countEl.textContent || '0') || 0) + 1);
      } catch {
        btn.disabled = false;
      }
    });
  });
</script>

<style>
.like {
  padding: clamp(2.5rem, 5vw, 4rem) var(--container-gutter);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
  border-top: 1px solid rgba(74, 57, 48, 0.1);
  background: var(--color-cream);
}

.like__label {
  font-family: var(--font-body);
  font-size: 0.65rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--color-clay);
  opacity: 0.7;
  margin: 0;
}

.like__btn {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  background: none;
  border: 1px solid rgba(74, 57, 48, 0.25);
  padding: 0.75rem 1.5rem;
  cursor: pointer;
  color: var(--color-clay);
  transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  font-family: var(--font-body);
  font-size: 0.85rem;
  font-weight: 300;
}

.like__btn:hover:not(:disabled) {
  border-color: var(--color-bark);
  color: var(--color-bark);
}

.like__btn--active {
  border-color: var(--color-bark) !important;
  color: var(--color-cream) !important;
  background: var(--color-bark) !important;
  cursor: default;
}

.like__btn--active .like__heart {
  fill: currentColor;
}

.like__btn:disabled:not(.like__btn--active) {
  opacity: 0.5;
  cursor: default;
}

.like__heart {
  transition: fill 0.2s ease;
  flex-shrink: 0;
}

.like__count {
  font-size: 0.8rem;
  min-width: 1ch;
}
</style>

---
const posts = [
  {
    href: '/blog/lieben-wir-hochzeiten',
    category: 'Hochzeiten',
    title: 'Deshalb lieben wir Hochzeiten – 15 unvergessliche Momente',
    cover: '/images/blog/lieben-wir-hochzeiten-hero.jpg',
    position: '25% 50%',
  },
  {
    href: '/blog/gruppenfotos',
    category: 'Hochzeiten',
    title: 'Gruppenfotos leicht gemacht – stressfrei und schön',
    cover: '/images/blog/gruppenfotos-hero.jpg',
    position: '65% 50%',
  },
  {
    href: '/blog/familie-mitwachsen',
    category: 'Familie',
    title: 'Bilder, die mitwachsen – vom Babybauch bis zur Familie',
    cover: '/images/blog/familie-mitwachsen-hero.jpg',
    position: '50% 50%',
  },
];
---

<section class="bt">
  <div class="bt__head">
    <span class="bt__eyebrow">Lesestoff für euch</span>
    <h2 class="bt__title">Aus unserem <em>Blog.</em></h2>
  </div>

  <div class="bt__track">
    {posts.map((post) => (
      <a href={post.href} class="bt__card">
        <div class="bt__card-inner">
          <img
            src={post.cover}
            alt={post.title}
            loading="lazy"
            class="bt__img"
            style={`object-position: ${post.position}`}
          />
          <div class="bt__overlay"></div>
          <span class="bt__category">{post.category}</span>
          <div class="bt__body">
            <p class="bt__card-title">{post.title}</p>
            <span class="bt__link">
              Lesen
              <svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/>
              </svg>
            </span>
          </div>
        </div>
      </a>
    ))}
  </div>

  <div class="bt__footer">
    <a href="/blog" class="bt__all">
      Alle Beiträge
      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/>
      </svg>
    </a>
  </div>
</section>

<style>
.bt {
  background: var(--color-parchment);
  padding: clamp(4rem, 8vw, 7rem) 0 clamp(3rem, 6vw, 5rem);
}

.bt__head {
  max-width: var(--container-max);
  margin-inline: auto;
  padding: 0 var(--container-gutter) clamp(2rem, 4vw, 3rem);
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.bt__eyebrow {
  font-family: var(--font-body);
  font-size: 0.62rem;
  letter-spacing: 0.38em;
  text-transform: uppercase;
  color: var(--color-clay);
  opacity: 0.7;
}

.bt__title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 700;
  color: var(--color-bark);
  line-height: 1.0;
  letter-spacing: -0.02em;
  margin: 0;
}

.bt__title em {
  font-style: italic;
  font-weight: 300;
  color: var(--color-clay);
}

/* ── Track: grid on desktop, scroll on mobile ── */
.bt__track {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2px;
  max-width: var(--container-max);
  margin-inline: auto;
  padding: 0 var(--container-gutter);
}

/* ── Card ── */
.bt__card {
  display: block;
  overflow: hidden;
}

.bt__card-inner {
  aspect-ratio: 3 / 4;
  position: relative;
  overflow: hidden;
}

.bt__card:hover .bt__card-inner img {
  transform: scale(1.04);
}

.bt__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.bt__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(18,14,13,0.92) 0%, rgba(18,14,13,0.35) 50%, rgba(18,14,13,0.05) 100%);
}

.bt__category {
  position: absolute;
  top: 1.5rem;
  left: 1.5rem;
  font-family: var(--font-body);
  font-size: 0.58rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.95);
  text-shadow: 0 1px 4px rgba(0,0,0,0.55);
}

.bt__body {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 2rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

.bt__card-title {
  font-family: var(--font-display);
  font-size: clamp(1.1rem, 1.8vw, 1.45rem);
  font-style: italic;
  font-weight: 300;
  color: var(--color-cream);
  line-height: 1.25;
  margin: 0;
}

.bt__link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-body);
  font-size: 0.6rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(196,181,172,0.7);
  transition: gap 0.2s ease, color 0.2s ease;
}

.bt__card:hover .bt__link {
  gap: 0.85rem;
  color: rgba(196,181,172,1);
}

/* ── Footer link ── */
.bt__footer {
  max-width: var(--container-max);
  margin-inline: auto;
  padding: 2rem var(--container-gutter) 0;
  display: flex;
  justify-content: flex-end;
}

.bt__all {
  display: inline-flex;
  align-items: center;
  gap: 0.65rem;
  font-family: var(--font-body);
  font-size: 0.62rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--color-bark);
  border: 1px solid rgba(145,124,113,0.45);
  padding: 0.9rem 2rem;
  transition: background 0.25s ease, border-color 0.25s ease, gap 0.2s ease;
}

.bt__all:hover {
  background: rgba(145,124,113,0.08);
  border-color: var(--color-clay);
  gap: 1rem;
}

/* ── Mobile: swipeable carousel ── */
@media (max-width: 720px) {
  .bt__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 0 var(--container-gutter);
    gap: 12px;
  }
  .bt__track::-webkit-scrollbar { display: none; }

  .bt__card {
    flex: 0 0 82vw;
    scroll-snap-align: start;
  }

  .bt__card-inner {
    aspect-ratio: 3 / 4;
  }
}
</style>

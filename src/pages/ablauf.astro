---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// ENTWURF – noch nicht in der Navigation verlinkt.

const flows = [
  {
    id: 'hochzeit',
    label: 'Hochzeit',
    intro: 'Von der ersten Nachricht bis zu eurer fertigen Galerie – so begleiten wir euch durch eure Hochzeit.',
    steps: [
      {
        title: 'Anfrage',
        text: 'Schreibt uns über das Kontaktformular – mit Datum, Ort und ein paar Worten zu eurem Tag. Wir melden uns in der Regel innerhalb von ein bis zwei Tagen.',
      },
      {
        title: 'Kennenlernen',
        text: 'In einem unverbindlichen Videocall oder Telefonat lernen wir uns kennen. Passt die Chemie? Welches Paket passt zu euren Vorstellungen? Hier ist Platz für alle eure Fragen.',
      },
      {
        title: 'Angebot & Buchung',
        text: 'Ihr bekommt euer individuelles Angebot. Sobald der unterschriebene Vertrag und die Anzahlung von 25 % bei uns sind, ist euer Termin fest für euch reserviert.',
      },
      {
        title: 'Finale Besprechung',
        text: 'Wenige Tage bis eine Woche vor der Hochzeit gehen wir per (Video-)Call gemeinsam alle Details durch: Ablauf und Timeline, eure Foto-Wünsche, die Liste für die Gruppenfotos und die Treffpunkte am Tag.',
      },
      {
        title: 'Euer Hochzeitstag',
        text: 'Wir sind entspannt und unaufdringlich dabei und halten fest, was passiert – ohne den Tag zu unterbrechen. Ihr erlebt eure Hochzeit, wir kümmern uns um die Bilder.',
      },
      {
        title: 'Bearbeitung',
        text: 'Je nach Paket bearbeiten wir eure Bilder in 14 bis 30 Tagen. Bei den Paketen Silber und Gold erhaltet ihr eine kleine Vorschau schon nach 48 Stunden. Die Restzahlung erfolgt innerhalb von 14 Tagen nach der Hochzeit.',
      },
      {
        title: 'Eure Online-Galerie',
        text: 'Ihr erhaltet alle Bilder in voller Auflösung und ohne Wasserzeichen in einer privaten Online-Galerie – zum Herunterladen und Teilen mit Familie und Freunden. Die Galerie bleibt mindestens 3 Monate online.',
      },
      {
        title: 'Und danach',
        text: 'Auf Wunsch bestellt ihr Abzüge oder Fotoprodukte nach oder bucht ein After-Wedding-Shooting. Meldet euch einfach – wir sind weiterhin für euch da. Und natürlich würden wir uns freuen, euch in Zukunft bei einem Shooting wiederzusehen.',
      },
    ],
  },
  {
    id: 'shooting',
    label: 'Paar & Familie',
    intro: 'Ein Shooting ist schnell organisiert – hier die wichtigsten Schritte von der Anfrage bis zu euren Bildern.',
    steps: [
      {
        title: 'Anfrage',
        text: 'Schreibt uns über das Kontaktformular – mit eurem Wunschzeitraum und ein paar Infos zu euch. Termine für Shootings finden wir meist recht kurzfristig.',
      },
      {
        title: 'Kennenlernen & Planung',
        text: 'Kurzer Austausch per Telefon, Videocall oder schriftlich: Wir klären gemeinsam Ort, Ablauf, Kleidung und eure Wünsche.',
      },
      {
        title: 'Terminbestätigung',
        text: 'Nach eurer Zusage bestätigen wir den Termin verbindlich. Die Zahlung klären wir im Vorhinein.',
      },
      {
        title: 'Das Shooting',
        text: 'Je nach Paket 20 bis 90 Minuten. Ganz ungezwungen – wo nötig, leiten wir euch mit kleinen Impulsen an, damit natürliche Bilder entstehen.',
      },
      {
        title: 'Bearbeitung',
        text: 'Wir bearbeiten eure Bilder in der Regel innerhalb von 14 Tagen.',
      },
      {
        title: 'Eure Online-Galerie',
        text: 'Ihr erhaltet eure Bilder in voller Auflösung in einer Online-Galerie – zum Herunterladen und Teilen. Einzelne Bilder lassen sich jederzeit nachbestellen.',
      },
    ],
  },
  {
    id: 'gutschein',
    label: 'Gutschein',
    intro: 'Verschenkt Erinnerungen: So kommt ihr an euren Wertgutschein – vom Wunschbetrag bis zur Übergabe.',
    image: '/images/website/diverses/gutschein.jpg',
    imageAlt: 'MiNi Photography Geschenkgutschein',
    steps: [
      {
        title: 'Anfrage',
        text: 'Schreibt uns über das Kontaktformular, welchen Betrag ihr verschenken möchtet, ob ihr den Gutschein als PDF oder gedruckt per Post bekommen wollt und was bei „Von" und „Für" draufstehen soll. Auf Wunsch lassen wir beide Felder frei – dann könnt ihr sie später selbst eintragen.',
      },
      {
        title: 'Bestätigung',
        text: 'Wir bestätigen euch die Bestellung kurz per E-Mail und schicken euch die Zahlungsinfos.',
      },
      {
        title: 'Zahlung',
        text: 'Ihr zahlt bequem per Überweisung oder PayPal. Sobald der Betrag bei uns eingegangen ist, geht es weiter.',
      },
      {
        title: 'Gutschein & Zustellung',
        text: 'Wir gestalten euren Gutschein mit dem gewünschten Betrag und euren Angaben zu „Von" und „Für" und schicken ihn euch – als PDF per E-Mail oder gedruckt per Post, rechtzeitig zum Verschenken.',
      },
      {
        title: 'Einlösung',
        text: 'Der oder die Beschenkte meldet sich einfach bei uns, und wir stimmen gemeinsam einen Termin ab. Der Gutscheinwert wird mit dem gewählten Paket verrechnet.',
      },
    ],
  },
];
---

<BaseLayout
  title="So läuft es ab – MiNi Photography"
  description="Von der ersten Anfrage bis zur fertigen Online-Galerie: So läuft die Zusammenarbeit mit MiNi Photography bei Hochzeiten, Paar- und Familienshootings ab."
>
  <Nav />
  <main id="main">

    <!-- ─── Hero ─────────────────────────────────────────── -->
    <section class="ab-hero">
      <div class="ab-hero__inner">
        <a href="/" class="ab-hero__back">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="13" y1="8" x2="3" y2="8"/><polyline points="7,4 3,8 7,12"/>
          </svg>
          Startseite
        </a>
        <span class="ab-hero__eyebrow">Zusammenarbeit</span>
        <h1 class="ab-hero__title">So läuft es <em>ab.</em></h1>
        <p class="ab-hero__sub">
          Transparent von der ersten Nachricht bis zu euren fertigen Bildern.
        </p>
      </div>
    </section>

    <!-- ─── Ablauf ───────────────────────────────────────── -->
    <section class="ab-body">
      <div class="ab-body__inner">

        <div class="ab-choose">
          <span class="ab-choose__label" id="ab-choose-label">Wofür interessiert ihr euch?</span>
          <div class="ab-toggle" role="tablist" aria-labelledby="ab-choose-label">
            {flows.map((flow, i) => (
              <button
                type="button"
                class={`ab-toggle__btn${i === 0 ? ' is-active' : ''}`}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                data-flow-btn={flow.id}
              >
                {flow.label}
              </button>
            ))}
          </div>
        </div>

        {flows.map((flow, i) => (
          <div class="ab-flow" data-flow={flow.id} hidden={i !== 0}>
            <p class="ab-flow__intro">{flow.intro}</p>
            {flow.image && (
              <figure class="ab-flow__figure">
                <img src={flow.image} alt={flow.imageAlt} loading="lazy" width="800" height="700" />
              </figure>
            )}
            <ol class="ab-steps">
              {flow.steps.map((step, s) => (
                <li class="ab-step">
                  <span class="ab-step__num" aria-hidden="true">{String(s + 1).padStart(2, '0')}</span>
                  <div class="ab-step__content">
                    <h2 class="ab-step__title">{step.title}</h2>
                    <p class="ab-step__text">{step.text}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))}

      </div>
    </section>

    <!-- ─── CTA ──────────────────────────────────────────── -->
    <section class="ab-cta">
      <div class="ab-cta__inner">
        <span class="ab-cta__eyebrow">Bereit?</span>
        <h2 class="ab-cta__heading">Erzählt uns von <em>euren Plänen.</em></h2>
        <a href="/#kontakt" class="ab-cta__btn">
          Kontakt aufnehmen
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/>
          </svg>
        </a>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
/* ─── Hero ────────────────────────────────────────────────── */
.ab-hero {
  background: var(--color-bark);
  padding: clamp(9rem, 18vw, 14rem) var(--container-gutter) clamp(4rem, 8vw, 7rem);
}

.ab-hero__inner {
  max-width: var(--container-max);
  margin-inline: auto;
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.ab-hero__back {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-family: var(--font-body);
  font-size: 0.7rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: rgba(196,181,172,0.6);
  transition: color 0.3s ease;
  margin-bottom: var(--space-4);
}

.ab-hero__back:hover { color: rgba(196,181,172,1); }

.ab-hero__eyebrow {
  font-family: var(--font-body);
  font-size: 0.7rem;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: #c4b5ac;
}

.ab-hero__title {
  font-family: var(--font-display);
  font-size: clamp(3rem, 7vw, 6rem);
  font-weight: 700;
  color: var(--color-cream);
  line-height: 1;
  letter-spacing: -0.01em;
}

.ab-hero__title em {
  font-style: italic;
  font-weight: 300;
  color: #c4b5ac;
}

.ab-hero__sub {
  font-family: var(--font-display);
  font-size: clamp(1.1rem, 2vw, 1.5rem);
  font-weight: 300;
  font-style: italic;
  color: rgba(255,252,250,0.7);
  margin-top: var(--space-2);
}

/* ─── Body ────────────────────────────────────────────────── */
.ab-body {
  background: var(--color-cream);
  padding: clamp(3rem, 7vw, 6rem) var(--container-gutter) clamp(4rem, 8vw, 7rem);
}

.ab-body__inner {
  max-width: 780px;
  margin-inline: auto;
}

/* ─── Auswahl / Toggle ────────────────────────────────────── */
.ab-choose {
  margin-bottom: clamp(2.5rem, 5vw, 4rem);
}

.ab-choose__label {
  display: block;
  font-family: var(--font-body);
  font-size: 0.7rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--color-clay);
  margin-bottom: var(--space-4);
}

.ab-toggle {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.ab-toggle__btn {
  font-family: var(--font-body);
  font-size: 0.72rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-bark);
  background: var(--color-cream);
  border: 1px solid rgba(92,72,67,0.35);
  padding: var(--space-3) clamp(1.25rem, 3vw, 1.75rem);
  cursor: pointer;
  transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
}

.ab-toggle__btn:hover {
  border-color: var(--color-clay);
  background: rgba(145,124,113,0.08);
}

.ab-toggle__btn.is-active {
  background: var(--color-clay);
  border-color: var(--color-clay);
  color: var(--color-cream);
}

.ab-toggle__btn:focus-visible {
  outline: 2px solid var(--color-clay);
  outline-offset: 2px;
}

/* ─── Intro ───────────────────────────────────────────────── */
.ab-flow__intro {
  font-family: var(--font-display);
  font-size: clamp(1.2rem, 2.2vw, 1.5rem);
  font-weight: 400;
  color: var(--color-bark);
  line-height: 1.7;
  margin-bottom: clamp(2.5rem, 5vw, 4rem);
}

/* ─── Bild ────────────────────────────────────────────────── */
.ab-flow__figure {
  margin: 0 0 clamp(2.5rem, 5vw, 4rem);
  overflow: hidden;
}

.ab-flow__figure img {
  width: 100%;
  height: auto;
  display: block;
}

/* ─── Steps ───────────────────────────────────────────────── */
.ab-steps {
  list-style: none;
  margin: 0;
  padding: 0;
}

.ab-step {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: clamp(1.25rem, 3vw, 2.5rem);
  padding: clamp(1.75rem, 3.5vw, 2.5rem) 0;
  border-top: 1px solid rgba(92,72,67,0.15);
}

.ab-step:last-child { border-bottom: 1px solid rgba(92,72,67,0.15); }

.ab-step__num {
  font-family: var(--font-display);
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  font-weight: 300;
  color: var(--color-clay);
  line-height: 1;
}

.ab-step__title {
  font-family: var(--font-display);
  font-size: clamp(1.5rem, 3vw, 2.1rem);
  font-weight: 400;
  color: var(--color-bark);
  line-height: 1.1;
  margin: 0 0 var(--space-3);
}

.ab-step__text {
  font-family: var(--font-body);
  font-size: 1rem;
  font-weight: 400;
  color: var(--color-bark);
  line-height: 1.75;
  margin: 0;
}

/* ─── CTA ─────────────────────────────────────────────────── */
.ab-cta {
  background: var(--color-parchment);
  padding: clamp(4rem, 8vw, 7rem) var(--container-gutter);
  text-align: center;
  border-top: 1px solid rgba(92,72,67,0.1);
}

.ab-cta__inner {
  max-width: 600px;
  margin-inline: auto;
}

.ab-cta__eyebrow {
  display: block;
  font-family: var(--font-body);
  font-size: 0.75rem;
  letter-spacing: 0.4em;
  text-transform: uppercase;
  color: var(--color-clay);
  margin-bottom: var(--space-6);
}

.ab-cta__heading {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 3.5vw, 3rem);
  font-weight: 700;
  color: var(--color-bark);
  line-height: 1.15;
  margin-bottom: var(--space-8);
}

.ab-cta__heading em {
  font-style: italic;
  font-weight: 300;
  color: var(--color-clay);
}

.ab-cta__btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  font-family: var(--font-body);
  font-size: 0.75rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--color-bark);
  border: 1px solid rgba(92,72,67,0.3);
  padding: var(--space-4) var(--space-8);
  transition: background 0.3s ease, border-color 0.3s ease;
}

.ab-cta__btn:hover {
  background: rgba(145,124,113,0.1);
  border-color: rgba(92,72,67,0.6);
}

.ab-cta__btn svg { transition: transform 0.25s ease; }
.ab-cta__btn:hover svg { transform: translateX(5px); }

/* ─── Responsive ──────────────────────────────────────────── */
@media (max-width: 540px) {
  .ab-step {
    grid-template-columns: 1fr;
    gap: var(--space-2);
  }
}
</style>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.ab-toggle__btn');
  const flows = document.querySelectorAll<HTMLElement>('.ab-flow');

  function activate(target: string | undefined) {
    let matched = false;
    btns.forEach((b) => {
      const active = b.dataset.flowBtn === target;
      if (active) matched = true;
      b.classList.toggle('is-active', active);
      b.setAttribute('aria-selected', String(active));
    });
    if (!matched) return;
    flows.forEach((flow) => {
      flow.hidden = flow.dataset.flow !== target;
    });
  }

  btns.forEach((btn) => {
    btn.addEventListener('click', () => activate(btn.dataset.flowBtn));
  });

  // Direktlink wie /ablauf#gutschein öffnet den passenden Reiter
  const fromHash = () => activate(location.hash.replace('#', ''));
  fromHash();
  window.addEventListener('hashchange', fromHash);
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Blog – MiNi Photography"
  description="Tipps, Geschichten und Einblicke hinter die Kamera von MiNi Photography. Bald verfügbar."
>
  <Nav />
  <main id="main">

    <section class="cs-hero">
      <div class="cs-inner">
        <a href="/" class="cs-back">
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="13" y1="8" x2="3" y2="8"/><polyline points="7,4 3,8 7,12"/>
          </svg>
          Startseite
        </a>

        <div class="cs-content">
          <span class="cs-eyebrow">Blog</span>
          <h1 class="cs-title">Bald findet ihr hier<br/><em>spannende Infos</em><br/>rund um das Thema<br/>Fotografie.</h1>
          <p class="cs-sub">Wir arbeiten daran – schaut bald wieder vorbei.</p>
          <div class="cs-divider"></div>
        </div>

        <div class="cs-topics">
          <span class="cs-topics__label">Was euch erwartet</span>
          <ul class="cs-topics__list">
            <li>Shooting-Tipps &amp; Outfit-Inspiration</li>
            <li>Hinter den Kulissen</li>
            <li>Standort-Empfehlungen rund um Frankfurt</li>
            <li>Geschichten unserer Kunden</li>
          </ul>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
.cs-hero {
  min-height: 100dvh;
  background: var(--color-bark);
  display: flex;
  align-items: stretch;
  position: relative;
  overflow: hidden;
}

.cs-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 80% 60% at 70% 40%, rgba(196,181,172,0.06) 0%, transparent 60%),
    radial-gradient(ellipse 50% 80% at 20% 80%, rgba(145,124,113,0.08) 0%, transparent 50%);
  pointer-events: none;
}

.cs-inner {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: var(--container-max);
  margin-inline: auto;
  padding: clamp(7rem, 12vw, 10rem) var(--container-gutter) clamp(4rem, 8vw, 7rem);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: clamp(3rem, 6vw, 5rem);
}

.cs-back {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-family: var(--font-body);
  font-size: 0.7rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: rgba(196,181,172,0.5);
  transition: color 0.3s ease;
  align-self: flex-start;
}
.cs-back:hover { color: rgba(196,181,172,0.9); }

.cs-content {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}

.cs-eyebrow {
  font-family: var(--font-body);
  font-size: 0.7rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--color-sand);
  opacity: 0.7;
}

.cs-title {
  font-family: var(--font-display);
  font-size: clamp(2.8rem, 7vw, 6rem);
  font-weight: 700;
  color: var(--color-cream);
  line-height: 0.95;
  letter-spacing: -0.02em;
  margin: 0;
}

.cs-title em {
  font-style: italic;
  font-weight: 300;
  color: var(--color-sand);
}

.cs-sub {
  font-family: var(--font-body);
  font-size: clamp(0.9rem, 1.5vw, 1.05rem);
  color: rgba(196,181,172,0.65);
  line-height: 1.75;
  max-width: 48ch;
  margin: 0;
}

.cs-divider {
  width: 48px;
  height: 1px;
  background: rgba(196,181,172,0.25);
}

.cs-cta {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  font-family: var(--font-body);
  font-size: 0.75rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-cream);
  border: 1px solid rgba(196,181,172,0.3);
  padding: var(--space-4) var(--space-8);
  transition: background 0.3s ease, border-color 0.3s ease;
  align-self: flex-start;
}
.cs-cta:hover {
  background: rgba(196,181,172,0.08);
  border-color: rgba(196,181,172,0.6);
}

.cs-topics {
  border-top: 1px solid rgba(196,181,172,0.12);
  padding-top: clamp(2rem, 4vw, 3rem);
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.cs-topics__label {
  font-family: var(--font-body);
  font-size: 0.65rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: rgba(196,181,172,0.4);
}

.cs-topics__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3) var(--space-8);
}

.cs-topics__list li {
  font-family: var(--font-display);
  font-size: clamp(0.95rem, 1.5vw, 1.15rem);
  font-style: italic;
  font-weight: 300;
  color: rgba(196,181,172,0.5);
  position: relative;
  padding-left: var(--space-4);
}

.cs-topics__list li::before {
  content: '—';
  position: absolute;
  left: 0;
  color: rgba(196,181,172,0.25);
  font-style: normal;
}
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Gutscheine – MiNi Photography"
  description="Fotoshooting-Gutscheine von MiNi Photography – das perfekte Geschenk. Verschenke Erinnerungen, die bleiben."
>
  <Nav />
  <main id="main">

    <!-- ─── Hero ─────────────────────────────────────────── -->
    <section class="gs-hero" aria-label="Gutscheine">
      <div class="gs-hero__img">
        <img
          src="/images/gutscheine/gutschein.jpg"
          alt="MiNi Photography Geschenkgutschein"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="gs-hero__overlay"></div>
      <div class="gs-hero__content">
        <a href="/" class="gs-hero__back">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="13" y1="8" x2="3" y2="8"/><polyline points="7,4 3,8 7,12"/>
          </svg>
          Startseite
        </a>
        <div class="gs-hero__text">
          <h1 class="gs-hero__title">Gut<em>scheine.</em></h1>
          <span class="gs-hero__sub">Verschenke Erinnerungen, die bleiben.</span>
        </div>
      </div>
      <div class="gs-hero__scroll" aria-hidden="true">
        <div class="gs-hero__scroll-line"></div>
        <span>Scroll</span>
      </div>
    </section>

    <!-- ─── Intro ────────────────────────────────────────── -->
    <section class="gs-intro">
      <div class="gs-intro__inner">
        <blockquote class="gs-intro__quote">
          Das schönste Geschenk ist Zeit –<br/>
          <em>festgehalten für immer.</em>
        </blockquote>
      </div>
    </section>

    <!-- ─── Hauptinhalt ──────────────────────────────────── -->
    <section class="gs-main">
      <div class="gs-main__inner">
        <div class="gs-body">

          <!-- Bild -->
          <div class="gs-image reveal">
            <img
              src="/images/gutscheine/gutschein.jpg"
              alt="MiNi Photography Geschenkgutschein für ein Fotoshooting"
              width="800"
              height="700"
              loading="lazy"
            />
          </div>

          <!-- Text -->
          <div class="gs-text reveal reveal--delay-1">
            <span class="section-label">Unsere Wertgutscheine</span>
            <h2 class="gs-text__heading">Wie erhältst du<br/><em>deinen Gutschein?</em></h2>
            <p class="gs-text__body">
              Nutze einfach unser <a href="/#kontakt" class="gs-text__link">Kontaktformular</a>, um deinen individuellen Gutschein anzufordern. Teile uns den gewünschten Betrag mit, und wir kümmern uns um den Rest!
            </p>
            <p class="gs-text__body">
              Schenke Erinnerungen mit MiNi Photography – wir freuen uns darauf, Teil eurer besonderen Momente zu sein!
            </p>

            <div class="gs-text__badge">
              Als PDF oder per Post erhältlich
            </div>

            <a href="/#kontakt" class="gs-text__btn">
              Gutschein anfragen
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/>
              </svg>
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- ─── CTA ──────────────────────────────────────────── -->
    <section class="gs-cta">
      <div class="gs-cta__inner">
        <span class="gs-cta__eyebrow">Schreibt uns!</span>
        <div class="gs-cta__image">
          <img src="/images/cta/uns-bei-der-arbeit.jpg" alt="Miette und Nicolai bei der Arbeit" loading="lazy" />
        </div>
        <h2 class="gs-cta__heading">Macht jemandem eine<br/><em>unvergessliche Freude.</em></h2>
        <a href="/#kontakt" class="gs-cta__btn">
          Kontakt
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/>
          </svg>
        </a>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
/* ─── Hero ────────────────────────────────────────────────── */
.gs-hero {
  position: relative;
  height: 100dvh;
  min-height: 600px;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}

.gs-hero__img {
  position: absolute;
  inset: 0;
}

.gs-hero__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  animation: gsBreathe 10s ease-in-out infinite;
}

@keyframes gsBreathe {
  0%, 100% { transform: scale(1); }
  50%       { transform: scale(1.035); }
}

.gs-hero__overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to top, rgba(30,20,16,0.88) 0%, rgba(30,20,16,0.35) 50%, rgba(30,20,16,0.15) 100%),
    linear-gradient(to right, rgba(30,20,16,0.3) 0%, transparent 60%);
}

.gs-hero__content {
  position: relative;
  z-index: 2;
  padding: var(--space-16) var(--container-gutter);
  width: 100%;
  max-width: var(--container-max);
  margin-inline: auto;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
}

.gs-hero__back {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-family: var(--font-body);
  font-size: 0.7rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: rgba(255,252,250,0.6);
  transition: color 0.3s ease;
  margin-top: 120px;
}

.gs-hero__back:hover { color: rgba(255,252,250,0.9); }

.gs-hero__text {
  padding-bottom: var(--space-8);
}

.gs-hero__title {
  font-family: var(--font-display);
  font-size: clamp(4rem, 10vw, 10rem);
  font-weight: 700;
  color: #fffcfa;
  line-height: 0.9;
  letter-spacing: -0.02em;
  opacity: 0;
  animation: gsFadeUp 1s ease forwards 0.4s;
}

.gs-hero__title em {
  font-style: italic;
  font-weight: 300;
  color: #c4b5ac;
}

.gs-hero__sub {
  display: block;
  font-family: var(--font-display);
  font-size: clamp(1.1rem, 2vw, 1.6rem);
  font-weight: 300;
  font-style: italic;
  color: rgba(255,252,250,0.7);
  margin-top: var(--space-4);
  opacity: 0;
  animation: gsFadeUp 0.9s ease forwards 0.65s;
}

.gs-hero__scroll {
  position: absolute;
  bottom: var(--space-8);
  right: var(--container-gutter);
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  font-family: var(--font-body);
  font-size: 0.6rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: rgba(196,181,172,0.6);
  writing-mode: vertical-lr;
  transform: rotate(180deg);
  opacity: 0;
  animation: gsFadeUp 1s ease forwards 1s;
}

.gs-hero__scroll-line {
  width: 1px;
  height: 48px;
  background: linear-gradient(to bottom, transparent, rgba(196,181,172,0.5));
  margin-bottom: var(--space-2);
}

@keyframes gsFadeUp {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ─── Intro ──────────────────────────────────────────────── */
.gs-intro {
  background: var(--color-cream);
  padding: clamp(4rem, 8vw, 7rem) var(--container-gutter);
}

.gs-intro__inner {
  max-width: 700px;
  margin-inline: auto;
  text-align: center;
}

.gs-intro__quote {
  font-family: var(--font-display);
  font-size: clamp(1.6rem, 3vw, 2.6rem);
  font-weight: 300;
  color: var(--color-bark);
  line-height: 1.3;
  margin: 0;
}

.gs-intro__quote em {
  font-style: italic;
  color: var(--color-clay);
}

/* ─── Hauptinhalt ────────────────────────────────────────── */
.gs-main {
  background: var(--color-parchment);
  padding: clamp(4rem, 8vw, 7rem) var(--container-gutter);
}

.gs-main__inner {
  max-width: var(--container-max);
  margin-inline: auto;
}

.gs-body {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: clamp(3rem, 6vw, 6rem);
  align-items: center;
}

/* Image */
.gs-image {
  overflow: hidden;
}

.gs-image img {
  width: 100%;
  height: auto;
  display: block;
  filter: sepia(0.05) contrast(1.02);
  transition: filter 0.5s ease, transform 0.7s ease;
}

.gs-image:hover img {
  filter: sepia(0) contrast(1);
  transform: scale(1.02);
}

/* Text */
.gs-text {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}

.gs-text .section-label {
  color: var(--color-clay);
}

.gs-text__heading {
  font-family: var(--font-display);
  font-size: clamp(2rem, 3.5vw, 3rem);
  font-weight: 300;
  color: var(--color-bark);
  line-height: 1.15;
  margin: 0;
}

.gs-text__heading em {
  font-style: italic;
  color: var(--color-clay);
}

.gs-text__body {
  font-family: var(--font-body);
  font-size: 0.95rem;
  font-weight: 400;
  color: var(--color-bark);
  line-height: 1.85;
}

.gs-text__link {
  color: var(--color-clay);
  text-decoration: underline;
  text-underline-offset: 3px;
  transition: color 0.3s ease;
}

.gs-text__link:hover {
  color: var(--color-bark);
}

.gs-text__badge {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  font-family: var(--font-body);
  font-size: 0.8rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  color: var(--color-clay);
  padding: 0;
}

.gs-text__btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  font-family: var(--font-body);
  font-size: 0.7rem;
  font-weight: 400;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: #fffcfa;
  background: var(--color-clay);
  border: 1px solid var(--color-clay);
  padding: var(--space-4) var(--space-8);
  align-self: flex-start;
  transition: background 0.3s ease, border-color 0.3s ease;
}

.gs-text__btn:hover {
  background: var(--color-bark);
  border-color: var(--color-bark);
}

.gs-text__btn svg {
  transition: transform 0.25s ease;
}

.gs-text__btn:hover svg {
  transform: translateX(4px);
}

/* ─── CTA ────────────────────────────────────────────────── */
.gs-cta {
  background: var(--color-cream);
  padding: clamp(4rem, 8vw, 7rem) var(--container-gutter);
  text-align: center;
}

.gs-cta__inner {
  max-width: 600px;
  margin-inline: auto;
}

.gs-cta__eyebrow {
  display: block;
  font-family: var(--font-body);
  font-size: 0.7rem;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: var(--color-clay);
  margin-bottom: var(--space-6);
}

.gs-cta__image {
  width: clamp(80px, 12vw, 130px);
  aspect-ratio: 1 / 1;
  margin-inline: auto;
  margin-bottom: var(--space-6);
  overflow: hidden;
}

.gs-cta__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.gs-cta__heading {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 3.5vw, 3rem);
  font-weight: 300;
  color: var(--color-bark);
  line-height: 1.2;
  margin-bottom: var(--space-8);
}

.gs-cta__heading em {
  font-style: italic;
  color: var(--color-clay);
}

.gs-cta__btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  font-family: var(--font-body);
  font-size: 0.7rem;
  font-weight: 400;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--color-bark);
  border: 1px solid rgba(92,72,67,0.3);
  padding: var(--space-4) var(--space-8);
  transition: background 0.3s ease, border-color 0.3s ease;
}

.gs-cta__btn:hover {
  background: rgba(145,124,113,0.1);
  border-color: rgba(92,72,67,0.6);
}

.gs-cta__btn svg {
  transition: transform 0.25s ease;
}

.gs-cta__btn:hover svg {
  transform: translateX(4px);
}

/* ─── Responsive ─────────────────────────────────────────── */
@media (max-width: 860px) {
  .gs-body {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 540px) {
  .gs-hero__scroll { display: none; }
}

@media (prefers-reduced-motion: reduce) {
  .gs-hero__img img { animation: none; }
  .gs-hero__title,
  .gs-hero__sub,
  .gs-hero__scroll { opacity: 1; animation: none; }
}
</style>

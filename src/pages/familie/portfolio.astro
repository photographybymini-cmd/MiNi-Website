  { src: '/images/portfolio/familie/familie/erinnerungen.jpg', alt: 'Familie – Foto', category: 'familie' as const },
];
---

<BaseLayout
  title="Familien Portfolio – MiNi Photography"
  description="Authentische Familienfotografie – unser Portfolio mit Babybauch, Newborn und Familien-Shootings. Natürlich und lebendig eingefangen von Miette & Nicolai."
>
  <Nav />
  <main id="main">

    <!-- Hero -->
    <section class="pf-hero pf-hero--has-img" aria-label="Portfolio Familien">
      <img class="pf-hero__bg" src="/images/portfolio/familie/cover.jpg" alt="" aria-hidden="true" fetchpriority="high" />
      <div class="pf-hero__inner">
        <a href="/familie" class="pf-hero__back">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="13" y1="8" x2="3" y2="8"/><polyline points="7,4 3,8 7,12"/>
          </svg>
          Familienfotografie
        </a>
        <span class="pf-hero__label">Portfolio</span>
        <h1 class="pf-hero__title"><em>Familien.</em></h1>
        <p class="pf-hero__count">Babybauch · Newborn · Familie</p>
      </div>
    </section>

    <!-- Intro -->
    <div class="pf-intro">
      <div class="pf-intro__inner">
        <div class="pf-intro__text">
          <h2 class="pf-intro__heading">Momente, die für immer<br/>zu eurer Geschichte gehören.</h2>
          <p class="pf-intro__sub">Kinder wachsen schnell – wir halten fest, was bleibt: die Wärme, das Lachen, das Miteinander.</p>
        </div>
        <a href="/familie" class="pf-intro__link">
          Mehr über Familienfotografie
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Filter -->
    <div class="pf-filter" role="group" aria-label="Nach Kategorie filtern">
      <div class="pf-filter__inner">
        <button class="pf-filter__btn is-active" data-filter="alle">Alle</button>
        <button class="pf-filter__btn" data-filter="babybauch">Babybauch</button>
        <button class="pf-filter__btn" data-filter="newborn">Newborn</button>
        <button class="pf-filter__btn" data-filter="familie">Familie</button>
      </div>
    </div>

    <!-- Grid -->
    <section class="pf-grid-section" aria-label="Familienfotos">
      <div class="pf-grid-section__inner">
        <div class="pf-grid" id="pf-grid">
          {allePhotos.map((p) => (
            <div class="pf-item" data-category={p.category}>
              <img src={p.src} alt={p.alt} loading="lazy" />
              <div class="pf-item__overlay"></div>
            </div>
          ))}
          {familieOnlyPhotos.map((p) => (
            <div class="pf-item" data-category={p.category} data-alle-exclude="true">
              <img src={p.src} alt={p.alt} loading="lazy" />
              <div class="pf-item__overlay"></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="pf-cta">
      <div class="pf-cta__inner">
        <span class="pf-cta__label">Für eure Familie</span>
        <h2 class="pf-cta__heading">Euer nächstes <em>Familienshooting?</em></h2>
        <div class="pf-cta__btns">
          <a href="/#kontakt" class="pf-cta__btn pf-cta__btn--primary">
            Jetzt anfragen
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/>
            </svg>
          </a>
          <a href="/preise" class="pf-cta__btn pf-cta__btn--secondary">Preise & Pakete</a>
        </div>
      </div>
    </section>

  </main>
  <Footer />

  <script>
    const btns = document.querySelectorAll<HTMLButtonElement>('.pf-filter__btn');
    const items = document.querySelectorAll<HTMLElement>('[data-category]');

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter!;

        btns.forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');

        items.forEach(item => {
          const isAlleExclude = item.dataset.alleExclude === 'true';
          const match = filter === 'alle'
            ? !isAlleExclude
            : item.dataset.category === filter;
          item.classList.toggle('is-hidden', !match);
        });
      });
    });

    /* Initial state: hide alle-exclude items (Alle tab is default) */
    document.querySelectorAll<HTMLElement>('[data-alle-exclude="true"]').forEach(item => {
      item.classList.add('is-hidden');
    });

    /* Hide broken placeholder images gracefully */
    document.querySelectorAll<HTMLImageElement>('.pf-item img').forEach(img => {
      img.addEventListener('error', () => { img.style.visibility = 'hidden'; });
    });
  </script>
</BaseLayout>
